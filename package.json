{
  "name": "@qairos-app/wallet-api",
  "version": "0.1.0",
  "description": "Signature-backed wallet sessions, shared ledger and read-only Ethereum monitoring.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Qairos",
    "email": "support@qairos.tech"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Qairos-app/qairos-wallet-api.git"
  },
  "bugs": {
    "url": "https://github.com/Qairos-app/qairos-wallet-api/issues"
  },
  "homepage": "https://github.com/Qairos-app/qairos-wallet-api#readme",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "validate": "pnpm typecheck && pnpm build && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.mjs",
    "test:integration": "node scripts/test-wallet-login.mjs",
    "release:package": "pnpm build && node scripts/package-release.mjs"
  },
  "files": [
    "dist",
    "src/db/schema",
    "migrations",
    "scripts/migrate.ts",
    "drizzle.config.ts",
    "openapi.yaml",
    ".env.example",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "express": "5.2.1",
    "ethers": "6.17.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.9.6",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}
